#!/usr/bin/python3
"""Launcher: always uses the system Python (PySide6 and libasound live there)."""

import os
import sys

HERE = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
for candidate in (HERE, "/usr/lib/sbg6"):
    if os.path.isdir(os.path.join(candidate, "g6app")):
        sys.path.insert(0, candidate)
        break

from g6app.cli import main

if __name__ == "__main__":
    raise SystemExit(main())
